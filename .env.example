# Server
PORT=3000
ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=gameuser
DB_PASSWORD=gamepass
DB_NAME=gamedb
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXP_HOURS=24
JWT_REFRESH_EXP_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# Rate Limit
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECS=60

# Game Server (shared secret for internal API auth)
GAME_SERVER_SECRET=change-me-use-openssl-rand-hex-32

# Workers
WORKERS_ENABLED=true
